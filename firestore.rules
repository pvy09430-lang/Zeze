rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bots Collection
    match /bots/{botId} {
      allow read, write: if true;
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Feedbacks Collection
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Bot Requests Collection
    match /botRequests/{botRequestId} {
      allow read, write: if true;
    }

    // Visitor Logs Collection
    match /visitorLogs/{logId} {
      allow read, write: if true;
    }

    // Global Settings Document
    match /global/authorSettings {
      allow read, write: if true;
    }

    // Polls Collection
    match /polls/{pollId} {
      allow read, write: if true;
    }

    // App Data Collection (mainState, visitorLogs, etc.)
    match /appData/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
